---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>
<body class="min-h-screen bg-[#1a1a2e] text-slate-200">
  <nav class="bg-[#0f172a] border-b border-slate-700 px-6 py-3 flex items-center gap-6">
    <span class="font-bold text-emerald-400 text-lg">🏃 Training</span>
    <a href="/" class="text-slate-300 hover:text-white text-sm">Wochenplan</a>
  </nav>
  <main class="max-w-[1800px] mx-auto px-4 py-6">
    <slot />
  </main>
  <div id="chat-root"></div>
  <script>
    document.addEventListener('keydown', (e) => {
      // Cmd+K → chat
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        document.dispatchEvent(new CustomEvent('toggle-chat'));
        return;
      }
      // Skip vim bindings when chat is open or input focused
      const tag = (e.target as HTMLElement).tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      // Ctrl+D / Ctrl+U half-page scroll (only when no modal open)
      if (e.ctrlKey && e.key === 'd') {
        e.preventDefault();
        window.scrollBy({ top: window.innerHeight / 2, behavior: 'smooth' });
      }
      if (e.ctrlKey && e.key === 'u') {
        e.preventDefault();
        window.scrollBy({ top: -(window.innerHeight / 2), behavior: 'smooth' });
      }
      // h = prev week, l = next week
      if (e.key === 'h' || e.key === 'H') {
        const prev = document.querySelector<HTMLAnchorElement>('[data-nav="prev"]');
        if (prev) prev.click();
      }
      if (e.key === 'l' || e.key === 'L') {
        const next = document.querySelector<HTMLAnchorElement>('[data-nav="next"]');
        if (next) next.click();
      }
    });

    // Auto-refresh every 5 minutes
    setInterval(() => location.reload(), 5 * 60 * 1000);
  </script>
</body>
</html>
